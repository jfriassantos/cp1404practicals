BoxLayout:
    orientation: 'vertical'
    BoxLayout:
        orientation: 'horizontal'
        TextInput:
            id: input_text
            text: '34'
            multiline: False
            size_hint_x: 4
        BoxLayout:
            orientation: 'vertical'
            Button:
                text: 'Up'
            Button:
                text: 'Down'
    Button:
        text: 'Convert miles to km'
        on_press: app.handle_convert(input_text.text)
    Label:
        text: app.output_text
        color: (1, 1, 0, 1)